generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  PERSONAL
  ENTERPRISE
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum OrgRole {
  ORG_ADMIN
  ING_ELECTRICIAN
  TECHNICIAN
  READER
}

enum ProjectStatus {
  DRAFT
  PENDING
  COMPLETED
}

enum ProjectType {
  RESIDENTIAL
  INDUSTRIAL
  SOLAR
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN_2FA
  PASSWORD_RESET
  EMAIL_CHANGE
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String?     @map("password_hash")
  fullName     String
  phone        String
  accountType  AccountType @default(PERSONAL)
  status       UserStatus  @default(PENDING_VERIFICATION)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  emailVerifiedAt DateTime?
  googleId        String?   @unique

  twoFactorEnabled   Boolean @default(false)
  totpSecretEncrypted String?

  failedLoginCount Int       @default(0)
  lastFailedLoginAt DateTime?
  lockoutLevel     Int       @default(0)
  lockedUntil      DateTime?

  organizations UserOrganization[]
  projects      Project[]          @relation("UserProjects")
  auditLogs     AuditLog[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  passkeys      PasskeyCredential[]
  invitationsSent Invitation[]     @relation("InvitationInviter")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?
  taxId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        UserOrganization[]
  projects       Project[]          @relation("OrganizationProjects")
  customCatalogs ComponentCatalog[]
  invitations    Invitation[]

  @@map("organizations")
}

model UserOrganization {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole  @default(TECHNICIAN)
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("user_organizations")
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           OrgRole
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  userAgent      String?
  ipAddress      String?
  approxLocation String?
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  revokedAt      DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  sessionId String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model RevokedAccessToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_access_tokens")
}

model OtpCode {4
  id          String     @id @default(uuid())
  userId      String
  purpose     OtpPurpose
  codeHash    String
  target      String?
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

model PasskeyCredential {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  version     String        @default("v1") // Versionnage (v1, v2...)
  type        ProjectType
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId String?
  user   User?   @relation("UserProjects", fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation("OrganizationProjects", fields: [organizationId], references: [id], onDelete: Cascade)

  installations Installation[]
  auditLogs     AuditLog[]

  @@index([userId])
  @@index([organizationId])
  @@map("projects")
}

model Installation {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  data      Json // Structure technique de l'installation

  @@index([projectId])
  @@map("installations")
}

model ComponentCatalog {
  id            String  @id @default(uuid())
  componentType String // CABLE, BREAKER, RCD, INVERTER, BATTERY
  reference     String // Référence fabricant ou normalisée
  technicalData Json // Propriétés techniques (Iz, calibres, tensions, etc.)
  isCustom      Boolean @default(false) // Vrai si créé par une organisation

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("component_catalogs")
}


model AuditLog {
  id        String   @id @default(uuid())
  action    String // LOGIN_FAILED, CREATE_PROJECT, VALIDATE_STUDY, REFRESH_REUSE_DETECTED...
  ipAddress String?
  details   Json?
  createdAt DateTime @default(now())

  // Optionnel : certains événements (connexion échouée) n'ont pas d'utilisateur identifié.
  // SetNull : on conserve la trace même si le compte est supprimé.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("audit_logs")
}