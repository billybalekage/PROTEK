NODE_ENV=development
HOST=0.0.0.0
PORT=5000
TRUST_PROXY=false

# Remplacez ces identifiants locaux et ne partagez jamais votre fichier .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/PROTEK?schema=public

# Générer une valeur aléatoire d'au moins 32 caractères pour chaque environnement.
JWT_SECRET=CHANGE_ME_generate_a_unique_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=15m

CORS_ORIGINS=http://localhost:3000
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=2000

SWAGGER_ENABLED=true
API_PUBLIC_URL=http://localhost:5000
